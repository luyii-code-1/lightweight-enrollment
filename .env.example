PORT=6754
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-database-password
DATABASE_URL=postgres://selection:change-me@postgres:5432/selection
COOKIE_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# New administrator bootstrap only: 32-character Base32 secret; SHA-1, 6 digits, 30 seconds.
ADMIN_TOTP_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:6754
COOKIE_SECURE=false
# HTTPS deployment: use only the public HTTPS origin, COOKIE_SECURE=true,
# and the observed reverse-proxy peer IP (Docker host gateway), not a wildcard.
TRUSTED_PROXIES=
DB_POOL_MAX=16
